(defpoll github-data
  :interval "600s"
  :initial '{"total":0,"unread":0,"by_reason":{"mention":0,"review_requested":0,"assign":0,"ci_activity":0,"comment":0},"items":[],"updated":"--:--"}'
  `scripts/fetch_github.sh`)

(defwidget notif-item [title repo type url]
  (button :onclick "xdg-open '${url}' &"
    (box :class "item" :space-evenly false
      (label :class "item-type type-${type}" :text type :width 50)
      (label :class "item-repo" :text repo :limit-width 28)
      (label :class "item-title" :text title :limit-width 28 :truncate true))))

(defwidget github-widget []
  (box :class "card" :orientation "v" :space-evenly false
    ;; Header
    (box :class "header" :space-evenly false :spacing 10 :halign "center"
      (image :class "github-logo" :path "assets/github-mark.svg"
             :image-width 25 :image-height 25)
      (label :class "badge" :text {github-data.unread} :visible {github-data.unread > 0}))

    ;; Reason summary
    (box :class "reasons" :space-evenly false :spacing 10
         :visible {github-data.total > 0}
      (label :class "reason-tag tag-mention" :text "@ ${github-data.by_reason.mention}"
             :visible {github-data.by_reason.mention > 0})
      (label :class "reason-tag tag-review" :text "review ${github-data.by_reason.review_requested}"
             :visible {github-data.by_reason.review_requested > 0})
      (label :class "reason-tag tag-assign" :text "assign ${github-data.by_reason.assign}"
             :visible {github-data.by_reason.assign > 0})
      (label :class "reason-tag tag-ci" :text "ci ${github-data.by_reason.ci_activity}"
             :visible {github-data.by_reason.ci_activity > 0})
      (label :class "reason-tag tag-comment" :text "comment ${github-data.by_reason.comment}"
             :visible {github-data.by_reason.comment > 0}))

    ;; Items
    (scroll :class "items-scroll" :vscroll true :hscroll false
            :height 188
            :visible {github-data.total > 0}
      (box :orientation "v" :space-evenly false
        (for item in {github-data.items}
          (notif-item :title {item.title} :repo {item.repo}
                      :type {item.type} :url {item.url}))))

    ;; Empty state
    (box :visible {github-data.total == 0} :class "empty-box"
      (label :class "empty" :text "All clear"))

    ;; Footer
    (box :class "footer" :space-evenly false :valign "end" :vexpand true
      (button :class "reload-btn" :onclick "scripts/reload.sh github &"
        (label :class "reload-icon" :text "↻"))
      (label :text "${github-data.total} total  ·  ${github-data.updated}"
             :hexpand true :xalign 1))))

(defwindow github
  :monitor 0
  :geometry (geometry
    :x "-25px"
    :y "50px"
    :width "375px"
    :height "563px"
    :anchor "top right")
  :stacking "bottom"
  :focusable false
  :windowtype "desktop"
  (github-widget))
